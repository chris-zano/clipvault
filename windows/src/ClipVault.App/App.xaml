<Application x:Class="ClipVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipVault.App"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No StartupUri: the window is created lazily, on first show, from
        App.xaml.cs. Starting as a tray daemon is the whole point of running
        with no arguments, so nothing WPF-heavy should exist until then.
    -->
    <Application.Resources>

    </Application.Resources>
</Application>
