<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClipVault.Core\ClipVault.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>clipvault</AssemblyName>
    <RootNamespace>ClipVault.App</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); the UI itself stays WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <!--
      Ship as one .exe: see the Publishing section of README.md for the
      exact publish command. RuntimeIdentifiers, not RuntimeIdentifier, so a
      plain `dotnet build` or `dotnet test` stays RID-agnostic and doesn't
      need these resolved. IncludeNativeLibrariesForSelfExtract folds the
      native deps this app actually ships (SQLite, SkiaSharp, libsodium via
      Geralt) into the exe too, instead of leaving them as loose DLLs beside it.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded once here; the tray icon loads the same file as a WPF
         resource stream instead of shipping (and risking drifting from) a
         second copy. -->
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
