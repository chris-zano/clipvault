<Window x:Class="ClipVault.App.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipVault input" SizeToContent="Height" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource PanelColor}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" Foreground="{DynamicResource FgColor}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel x:Name="Field1Panel" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="Field1Label" Foreground="{DynamicResource FgDimColor}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="Field1Box" Padding="7" />
        </StackPanel>

        <StackPanel x:Name="Field2Panel" Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="Field2Label" Foreground="{DynamicResource FgDimColor}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="Field2Box" Padding="7" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <Button Content="OK" Padding="12,6" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
